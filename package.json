{
  "name": "obsidian-yogurt-sync",
  "version": "0.1.0",
  "description": "Sync meeting notes from Yogurt into your Obsidian vault through Yogurt's local MCP server.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "fixture": "vitest run test/e2e.test.ts"
  },
  "keywords": ["obsidian", "yogurt", "meetings", "mcp"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "moment": "^2.30.1",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.4"
  }
}
